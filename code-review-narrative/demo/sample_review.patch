diff --git a/db/memtable_test.cc b/db/memtable_test.cc
--- a/db/memtable_test.cc
+++ b/db/memtable_test.cc
@@ -46,0 +47,15 @@
+TEST(MemTableTest, TrackedSizeMonotonic) {
+  InternalKeyComparator cmp(BytewiseComparator());
+  MemTable* mem = new MemTable(cmp);
+  mem->Ref();
+
+  size_t prev = mem->ApproximateMemoryUsage();
+  for (int i = 0; i < 100; i++) {
+    mem->Add(i, kTypeValue, "k" + std::to_string(i), "v");
+    size_t now = mem->ApproximateMemoryUsage();
+    ASSERT_GT(now, prev) << "size should grow after each Add";
+    prev = now;
+  }
+
+  mem->Unref();
+}
@@ -62,0 +63,16 @@
+TEST(MemTableTest, TrackedSizeApproximatesArena) {
+  InternalKeyComparator cmp(BytewiseComparator());
+  MemTable* mem = new MemTable(cmp);
+  mem->Ref();
+  for (int i = 0; i < 1000; i++) {
+    mem->Add(i, kTypeValue, "key" + std::to_string(i), "value");
+  }
+  size_t tracked = mem->ApproximateMemoryUsage();
+  // Tracked size should be in the same order of magnitude as arena.
+  // We allow 50% slop in either direction.
+  // (No direct arena access in test; this is a placeholder for
+  //  whatever ground-truth comparison the team agrees on.)
+  ASSERT_GT(tracked, 1000 * 10);
+  ASSERT_LT(tracked, 1000 * 1000);
+  mem->Unref();
+}
